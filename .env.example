# ─────────────────────────────────────────────────────────────────────────────
# Sirak Embibel Portfolio — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Digital Twin Chatbot (OpenRouter) ─────────────────────────────────────
# Get a free API key at https://openrouter.ai
# Without this key, the chatbot will show an offline message to visitors.
OPENROUTER_API_KEY=

# The model to use as the primary AI twin (falls back through free models if rate-limited)
# Recommended free options: google/gemma-4-31b-it:free | meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used as the HTTP-Referer header in OpenRouter API requests
NEXT_PUBLIC_APP_URL=https://sirakembibel.com

# ── Contact Form (Google Forms) ───────────────────────────────────────────────
# Set these to wire the contact page form to a Google Form.
# Leave blank to disable the Google Form integration.
GOOGLE_FORM_LINK=
GOOGLE_FORM_ENTRY_NAME=
GOOGLE_FORM_ENTRY_EMAIL=
GOOGLE_FORM_ENTRY_MESSAGE=
